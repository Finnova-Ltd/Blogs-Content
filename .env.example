# Canva Connect API Integration Credentials
CANVA_CLIENT_ID=YOUR_CANVA_CLIENT_ID
CANVA_CLIENT_SECRET=YOUR_CANVA_CLIENT_SECRET
CANVA_REDIRECT_URI=https://ezmortgagebroker.com.au/api/canva/callback

# ==============================================================================
# EMAIL SERVER CONFIGURATION (AXIGEN / HOSTYOURSERVICES)
# ==============================================================================
# Inbound Mail (IMAP SSL)
IMAP_HOST=ax.email
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=info@ezmortgagebroker.com.au
IMAP_PASSWORD=YOUR_EMAIL_PASSWORD

# Outbound Mail (SMTP SSL)
SMTP_HOST=ax.email
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=info@ezmortgagebroker.com.au
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_FROM_ADDRESS=info@ezmortgagebroker.com.au
MAIL_FROM_NAME="EZ Mortgage Broker"

# Webmail & Alternative Server Details
WEBMAIL_URL=https://ax.email
INCOMING_POP3_PORT=995
INCOMING_IMAP_PORT=993
OUTGOING_SMTP_PORT=465

# ==============================================================================
# BOT PROTECTION & CAPTCHA CONFIGURATION
# ==============================================================================
# Cloudflare Turnstile Bot Protection
VITE_CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CF_TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# Custom CAPTCHA & Image Providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=
CAPTCHA_PER_PROVIDER_COUNT=10
